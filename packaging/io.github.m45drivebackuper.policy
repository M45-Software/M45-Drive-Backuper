<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>M45 Drive Backuper</vendor>
  <action id="io.github.m45drivebackuper.manage">
    <description>Manage the existing Borg backup service</description>
    <message>Authentication is required to manage Borg backups or read the backup archive catalog.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/m45-drive-backuper/backend</annotate>
  </action>
</policyconfig>
